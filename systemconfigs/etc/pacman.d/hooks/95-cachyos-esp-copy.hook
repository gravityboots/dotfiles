[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = boot/vmlinuz-linux-cachyos
Target = boot/initramfs-linux-cachyos.img
Target = boot/initramfs-linux-cachyos-fallback.img
Target = boot/vmlinuz-linux-cachyos-lts
Target = boot/initramfs-linux-cachyos-lts.img
Target = boot/amd-ucode.img
Target = boot/intel-ucode.img

[Action]
Description = Copying kernel and initramfs to ESP for rEFInd...
When = PostTransaction
Exec = /usr/bin/sh -c "for f in vmlinuz-linux-cachyos initramfs-linux-cachyos.img initramfs-linux-cachyos-fallback.img vmlinuz-linux-cachyos-lts initramfs-linux-cachyos-lts.img amd-ucode.img intel-ucode.img; do [ -f /boot/$f ] && cp /boot/$f /boot/efi/EFI/cachyos/; done; true"
