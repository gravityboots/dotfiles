// Inspired by Catnap (https://github.com/iinsertNameHere/catnap)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/logo4r.png",
        "width": 28,
        // "height": 16,
        "padding": {
            "top": 0,
            "left": 0,
            "right": 3
        }
    },
    "display": {
        "separator": ">  ",
        "color": {
            "keys": "bright_black",
            "separator": "bright_black"
        },
        "constants": [
            "────────────────────────────────────────────────────────────",
            "│\u001b[60C│\u001b[60D",
            "───────────────────────────────────────────────────────────────────────────",
            "│\u001b[75C│\u001b[75D",
            "────────────┼──────────────────────────────────────────────────────────────",
            "────────────┴──────────────────────────────────────────────────────────────"
        ]
    },
    "modules": [
        {
            "format": "{#1}{#keys}╭{$1}╮", //\u001b[76D {#34}{user-name}{#37}@{#34}{host-name} 🖥  
            "type": "title"
        },
        {
            "key": "{$2}{#34} user     ",
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        {
            "format": "{#1}{#keys}├{$1}┤",
            "type": "custom"
        },
        {
            "key": "{$2}{#36}󰻀 os       ",
            "type": "os"
        },
        {
            "key": "{$2}{#36}󰌢 kernel   ",
            "type": "kernel"
        },
        {
            "key": "{$2}{#36}󱂬 wm       ",
            "type": "wm"
        },
        {
            "key": "{$2}{#36} shell    ",
            "type": "shell"
        },
        {
            "format": "{#1}{#keys}├{$1}┤",
            "type": "custom"
        },
        {
            "key": "{$2}{#32}󰍛 cpu      ",
            "type": "cpu",
            "showPeCoreCount": true,
            "temp": true
        },
        {
            "key": "{$2}{#32} memory   ",
            "type": "memory"
        },
        {
            "key": "{$2}{#32}󰉉 disk     ",
            "type": "disk",
            "folders": "/"
        },
        {
            "format": "{#1}{#keys}├{$1}┤",
            "type": "custom"
        },
        {
            "key": "{$2}{#35}󰩟 network  ",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "key": "{$2}{#35}󰏖 pkgs     ",
            "type": "packages"
        },
        {
            "key": "{$2}{#35}󰅐 uptime   ",
            "type": "uptime"
        },
        {
            "format": "{#1}{#keys}├{$1}┤",
            "type": "custom"
        },
        {
            "key": "{$2}{#37}󰮯 fetch    ",
            "type": "custom",
            "format": "\u001b[33m󰮯 \u001b[30m󰊠 \u001b[31m󰊠 \u001b[32m󰊠 \u001b[34m󰊠 \u001b[35m󰊠 \u001b[36m󰊠 \u001b[37m󰊠"
        },
        {
            "format": "{#1}{#keys}╰{$1}╯",
            "type": "custom"
        }
    ]
}